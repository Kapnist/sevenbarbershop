# Photos de la médiathèque : seules les images sont servies, aucun script ne s'exécute ici.
Options -Indexes
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<FilesMatch "\.(webp|jpe?g|png)$">
  Require all granted
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
